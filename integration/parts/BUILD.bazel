#
# A part built by a module that depends on rules_brep: the hermetic Python,
# the locked wheels, the pinned GL libraries and the runner, across the
# module boundary; the same bytes in two configurations (issue #8).
load("@rules_brep//brep:defs.bzl", "cad_assembly", "cad_part", "determinism_test", "interference_test")

cad_part(
    name = "bracket",
    src = "bracket.py",
    params = {"thickness": "4"},
    visibility = [
        "//geometry_equal:__pkg__",
        "//render:__pkg__",
    ],
)

determinism_test(
    name = "bracket_determinism_test",
    size = "small",
    target = ":bracket",
)

# Two brackets back to back (issue #9).
cad_assembly(
    name = "pair",
    parts = {":bracket": '[{"pos": [0, 0, 0]}, {"pos": [0, 30, 0], "rot": [0, 0, 180]}]'},
)

determinism_test(
    name = "pair_determinism_test",
    size = "small",
    target = ":pair",
)

# The two brackets do not overlap (issue #13).
interference_test(
    name = "pair_interference_test",
    size = "small",
    assembly = ":pair",
)

# The same bracket in CadQuery (issue #15): its own toolchain and wheels,
# fetched only because this part asks for them.
cad_part(
    name = "cq_bracket",
    src = "cq_bracket.py",
    library = "cadquery",
    params = {"thickness": "4"},
    visibility = ["//geometry_equal:__pkg__"],
)

determinism_test(
    name = "cq_bracket_determinism_test",
    size = "small",
    target = ":cq_bracket",
)
