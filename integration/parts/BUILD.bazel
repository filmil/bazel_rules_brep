#
# A part built by a module that depends on rules_brep: the hermetic Python,
# the locked wheels, the pinned GL libraries and the runner, across the
# module boundary; the same bytes in two configurations (issue #8).
load("@rules_brep//brep:defs.bzl", "cad_part", "determinism_test")

cad_part(
    name = "bracket",
    src = "bracket.py",
    params = {"thickness": "4"},
    visibility = ["//render:__pkg__"],
)

determinism_test(
    name = "bracket_determinism_test",
    size = "small",
    target = ":bracket",
)
