#
# The e2e bracket measured by a module that depends on rules_brep: the
# measurer with OCP and the pinned GL libraries, and the Go checker, across
# the module boundary (issue #11).
load("@rules_brep//brep:defs.bzl", "geometry_equal_test")

# The part against its own STEP file, named through a filegroup.
filegroup(
    name = "bracket_files",
    srcs = ["//parts:bracket"],
)

geometry_equal_test(
    name = "bracket_geometry_test",
    size = "small",
    a = "//parts:bracket",
    b = ":bracket_files",
)
