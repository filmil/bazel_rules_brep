#
# The e2e bracket's views, rendered by a module that depends on rules_brep:
# the renderer, matplotlib from the locked wheels, and OCP with the pinned
# GL libraries, across the module boundary; the same bytes in two
# configurations (issue #10).
load("@rules_brep//brep:defs.bzl", "cad_render", "determinism_test")

cad_render(
    name = "bracket_views",
    src = "//parts:bracket",
)

determinism_test(
    name = "bracket_views_determinism_test",
    size = "small",
    target = ":bracket_views",
)
