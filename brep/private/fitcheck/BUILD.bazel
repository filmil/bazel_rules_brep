load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

# pcb_fit_test's checker (issue #14); see main.go.

go_library(
    name = "fitcheck_lib",
    srcs = ["main.go"],
    importpath = "github.com/filmil/bazel_rules_brep/brep/private/fitcheck",
    visibility = ["//visibility:private"],
    deps = ["@rules_go//go/runfiles"],
)

go_binary(
    name = "fitcheck",
    embed = [":fitcheck_lib"],
    pure = "on",
    visibility = ["//brep/toolchains:__pkg__"],
)

go_test(
    name = "fitcheck_test",
    size = "small",
    srcs = ["main_test.go"],
    embed = [":fitcheck_lib"],
    pure = "on",
)
