"""The shared libraries OCP loads that its wheel does not bundle (issue #7).

OCP, OCCT's Python binding, links libGL.so.1, libX11.so.6 and
libexpat.so.1. Its
manylinux wheel leaves them to the host, as the manylinux policy allows,
and a host without them cannot import build123d. Nothing here renders with
OpenGL, but the loader needs them. They come from Debian 11 (the oldest
glibc in the presubmit matrix) packages, pinned by sha256, and the CAD
toolchain puts them on the runner's LD_LIBRARY_PATH.

libglx0 also names libglx-mesa0, the vendor library that libglvnd opens
only when an OpenGL context is made; nothing makes one, so it is left out.
"""

# Package: (pool path, sha256). From the Debian 11 (bullseye) main index.
_DEBS = {
    "libbsd0": ("pool/main/libb/libbsd/libbsd0_0.11.3-1+deb11u1_amd64.deb", "6ec5a08a4bb32c0dc316617f4bbefa8654c472d1cd4412ab8995f3955491f4a8"),
    "libexpat1": ("pool/main/e/expat/libexpat1_2.2.10-2+deb11u5_amd64.deb", "5744040c4735bcdd51238aebfa3e402b857244897f1007f61154982ebe5abbd7"),
    "libgl1": ("pool/main/libg/libglvnd/libgl1_1.3.2-1_amd64.deb", "f300f9610b5f05f1ce566c4095f1bf2170e512ac5d201c40d895b8fce29dec98"),
    "libglvnd0": ("pool/main/libg/libglvnd/libglvnd0_1.3.2-1_amd64.deb", "52a4464d181949f5ed8f7e55cca67ba2739f019e93fcfa9d14e8d65efe98fffc"),
    "libglx0": ("pool/main/libg/libglvnd/libglx0_1.3.2-1_amd64.deb", "cb642200f7e28e6dbb4075110a0b441880eeec35c8a00a2198c59c53309e5e17"),
    "libmd0": ("pool/main/libm/libmd/libmd0_1.0.3-3_amd64.deb", "9e425b3c128b69126d95e61998e1b5ef74e862dd1fc953d91eebcc315aea62ea"),
    "libx11-6": ("pool/main/libx/libx11/libx11-6_1.7.2-1+deb11u2_amd64.deb", "2b3b959cb10c07be065eb638a8577fe20f282045aaef76425dbd7310d1244b8c"),
    "libxau6": ("pool/main/libx/libxau/libxau6_1.0.9-1_amd64.deb", "679db1c4579ec7c61079adeaae8528adeb2e4bf5465baa6c56233b995d714750"),
    "libxcb1": ("pool/main/libx/libxcb/libxcb1_1.14-3_amd64.deb", "d5e0f047ed766f45eb7473947b70f9e8fddbe45ef22ecfd92ab712c0671a93ac"),
    "libxdmcp6": ("pool/main/libx/libxdmcp/libxdmcp6_1.1.2-3_amd64.deb", "ecb8536f5fb34543b55bb9dc5f5b14c9dbb4150a7bddb3f2287b7cab6e9d25ef"),
}

# The mirrors to try, in order: the live one, then the archive that takes
# over a Debian release when it leaves the mirrors.
_MIRRORS = [
    "https://deb.debian.org/debian/",
    "https://archive.debian.org/debian/",
]

# The sonames the loader asks for, which go into lib/.
_SONAMES = [
    "libGL.so.1",
    "libGLX.so.0",
    "libGLdispatch.so.0",
    "libX11.so.6",
    "libXau.so.6",
    "libXdmcp.so.6",
    "libbsd.so.0",
    "libexpat.so.1",
    "libmd.so.0",
    "libxcb.so.1",
]

_BUILD = """\\
# Generated by the gl_libs module extension of rules_brep.
filegroup(
    name = "libs",
    srcs = glob(["lib/*"]),
    visibility = ["//visibility:public"],
)
"""

def _gl_libs_repo_impl(rctx):
    for name in sorted(_DEBS.keys()):
        path, sha = _DEBS[name]
        rctx.download_and_extract(
            url = [m + path for m in _MIRRORS],
            sha256 = sha,
            type = "deb",
            output = "debs/" + name,
        )

        # Bazel unpacks the .deb's ar archive; the files are in data.tar.xz.
        rctx.extract("debs/%s/data.tar.xz" % name, output = "debs/%s/data" % name)
    found = {}
    for name in sorted(_DEBS.keys()):
        for d in ["lib/x86_64-linux-gnu", "usr/lib/x86_64-linux-gnu"]:
            dir = rctx.path("debs/%s/data/%s" % (name, d))
            if not dir.exists:
                continue
            for f in dir.readdir():
                if f.basename in _SONAMES:
                    # The soname is a link in the package; lib/ links to the
                    # file it names, which stays in debs/.
                    rctx.symlink(f.realpath, "lib/" + f.basename)
                    found[f.basename] = True
    missing = [s for s in _SONAMES if s not in found]
    if missing:
        fail("rules_brep: the Debian packages lack %s" % missing)
    rctx.file("BUILD.bazel", _BUILD)

_gl_libs_repo = repository_rule(implementation = _gl_libs_repo_impl)

def _gl_libs_impl(mctx):
    _gl_libs_repo(name = "brep_gl_libs")
    return mctx.extension_metadata(reproducible = True)

gl_libs = module_extension(
    implementation = _gl_libs_impl,
    doc = "Makes `@brep_gl_libs//:libs`, the GL and X11 libraries OCP loads.",
)
