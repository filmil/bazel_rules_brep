load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

# cad_check_test's checker (issue #12); see main.go.

go_library(
    name = "partcheck_lib",
    srcs = ["main.go"],
    importpath = "github.com/filmil/bazel_rules_brep/brep/private/partcheck",
    visibility = ["//visibility:private"],
    deps = ["@rules_go//go/runfiles"],
)

go_binary(
    name = "partcheck",
    embed = [":partcheck_lib"],
    pure = "on",
    visibility = ["//brep/toolchains:__pkg__"],
)

go_test(
    name = "partcheck_test",
    size = "small",
    srcs = ["main_test.go"],
    embed = [":partcheck_lib"],
    pure = "on",
)
