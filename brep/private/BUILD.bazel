load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@bazel_skylib//rules:common_settings.bzl", "string_flag")
load(":numbers_test.bzl", "numbers_test")

bzl_library(
    name = "private",
    srcs = [
        "assembly.bzl",
        "cad_toolchain.bzl",
        "check.bzl",
        "determinism.bzl",
        "geometry_equal.bzl",
        "gl_libs.bzl",
        "interference.bzl",
        "numbers.bzl",
        "part.bzl",
        "pcb_fit.bzl",
        "render.bzl",
        "run_tool.bzl",
        "step_file.bzl",
        "swap_test.bzl",
        "toolchains.bzl",
    ],
    visibility = ["//brep:__subpackages__"],
    deps = ["@bazel_skylib//rules:common_settings"],
)

# A setting that changes nothing but the configuration. determinism_test
# builds its target once with "a" and once with "b", so every action runs
# twice, with different output paths.
string_flag(
    name = "determinism_salt",
    build_setting_default = "",
    visibility = ["//visibility:public"],
)

# parse_number, which every rule here uses to check numbers it takes as
# strings: what it reads, and what it refuses.
numbers_test(
    name = "numbers_test",
    size = "small",
)
