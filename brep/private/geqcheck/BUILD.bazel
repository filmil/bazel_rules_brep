load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "geqcheck_lib",
    srcs = ["main.go"],
    importpath = "github.com/filmil/bazel_rules_brep/brep/private/geqcheck",
    visibility = ["//visibility:private"],
    deps = ["@rules_go//go/runfiles"],
)

go_binary(
    name = "geqcheck",
    embed = [":geqcheck_lib"],
    pure = "on",
    visibility = ["//visibility:public"],
)

go_test(
    name = "geqcheck_test",
    size = "small",
    srcs = ["main_test.go"],
    embed = [":geqcheck_lib"],
    pure = "on",
)
