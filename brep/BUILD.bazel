load("@bazel_skylib//:bzl_library.bzl", "bzl_library")

bzl_library(
    name = "defs",
    srcs = ["defs.bzl"],
    visibility = ["//visibility:public"],
    deps = ["//brep/private"],
)

# The toolchain type of this module's own Go helpers: the launcher that
# every action runs through, and the stub and checker of swap_test.
toolchain_type(
    name = "helpers_toolchain_type",
    visibility = ["//visibility:public"],
)

# The CAD toolchain: the CAD runner, which builds part scripts with
# build123d and OCCT (issue #7). See CadToolchainInfo.
toolchain_type(
    name = "toolchain_type",
    visibility = ["//visibility:public"],
)

exports_files(
    ["defs.bzl"],
    visibility = ["//docs:__pkg__"],
)
