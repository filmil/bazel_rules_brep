load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@bazel_skylib//rules:common_settings.bzl", "int_flag")

# The time every time stamp in an output becomes, in seconds since 1970
# UTC (spec D2): --@hdlf_rules_brep//brep:source_date_epoch=N. Default 0.
int_flag(
    name = "source_date_epoch",
    build_setting_default = 0,
    visibility = ["//visibility:public"],
)

bzl_library(
    name = "defs",
    srcs = ["defs.bzl"],
    visibility = ["//visibility:public"],
    deps = ["//brep/private"],
)

# The toolchain type of this module's own Go helpers: the launcher that
# every action runs through, and the stub and checker of swap_test.
toolchain_type(
    name = "helpers_toolchain_type",
    visibility = ["//visibility:public"],
)

# The CAD toolchain: the CAD runner, which builds part scripts with
# build123d and OCCT (issue #7). See CadToolchainInfo.
toolchain_type(
    name = "toolchain_type",
    visibility = ["//visibility:public"],
)

exports_files(
    ["defs.bzl"],
    visibility = ["//docs:__pkg__"],
)
