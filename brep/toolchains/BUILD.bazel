load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("//brep/private:cad_toolchain.bzl", "cad_toolchain")
load("//brep/private:toolchains.bzl", "helpers_toolchain", "unsupported_platform_toolchain")

# --@rules_brep//brep/toolchains:use_stub swaps every tool for the stub.
# swap_test sets it with a transition. A tool toolchain honors it by
# carrying target_settings = [":stub_off"], and its stub twin
# target_settings = [":stub_on"].
bool_flag(
    name = "use_stub",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

config_setting(
    name = "stub_on",
    flag_values = {":use_stub": "true"},
    visibility = ["//visibility:public"],
)

config_setting(
    name = "stub_off",
    flag_values = {":use_stub": "false"},
    visibility = ["//visibility:public"],
)

helpers_toolchain(
    name = "helpers_impl",
    compare = "//brep/private/detcompare",
    launcher = "//brep/private/launcher",
    swapcheck = "//brep/private/swapcheck",
)

# The helpers run on Linux x86_64 only in v1 (spec P1). The outputs of the
# rules are files for any platform, so the target platform is not
# constrained here; issue #6 adds the analysis-time check for other hosts.
toolchain(
    name = "helpers",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    toolchain = ":helpers_impl",
    toolchain_type = "//brep:helpers_toolchain_type",
)

# Any other execution platform: Bazel tries toolchains in the order they
# are registered, and MODULE.bazel registers this one last, so it is
# picked only where the one above does not match. Its analysis fails with
# a message that says which platform is supported (spec P1).
unsupported_platform_toolchain(
    name = "unsupported_impl",
    tags = ["manual"],
    visibility = ["//tests:__subpackages__"],
)

toolchain(
    name = "unsupported",
    toolchain = ":unsupported_impl",
    toolchain_type = "//brep:helpers_toolchain_type",
)

# The CAD runner (issue #7) and renderer (issue #10): build123d, OCP and
# matplotlib on the hermetic Python 3.12.
cad_toolchain(
    name = "cad_impl",
    libs = "@brep_gl_libs//:libs",
    python_version = "3.12",
    renderer = "//brep/private/renderer",
    runner = "//brep/private/runner",
    # The integration module builds it, as a user's module would.
    visibility = ["//visibility:public"],
)

toolchain(
    name = "cad",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    target_settings = [":stub_off"],
    toolchain = ":cad_impl",
    toolchain_type = "//brep:toolchain_type",
)

# swap_test's CAD runner: the stub stands in for it.
cad_toolchain(
    name = "cad_stub_impl",
    python_version = "3.12",
    renderer = "//brep/private/stub",
    runner = "//brep/private/stub",
)

toolchain(
    name = "cad_stub",
    target_settings = [":stub_on"],
    toolchain = ":cad_stub_impl",
    toolchain_type = "//brep:toolchain_type",
)

# Any other execution platform, for the CAD toolchain type: registered last,
# so it is picked only where the ones above do not match, and its analysis
# says which platform is supported (spec P1).
toolchain(
    name = "cad_unsupported",
    toolchain = ":unsupported_impl",
    toolchain_type = "//brep:toolchain_type",
)
