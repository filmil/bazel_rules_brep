#
# cad_part (issue #8): a bracket that imports a helper, built into STEP and
# STL through the CAD toolchain; the files read back; the same bytes in two
# configurations; and parameters that fail analysis.
load("@rules_go//go:def.bzl", "go_test")
load("//brep:defs.bzl", "cad_part", "determinism_test", "geometry_equal_test", "swap_test")
load("//tests:fails_test.bzl", "fails_test")
load(":action_test.bzl", "cq_runner_test", "part_action_test")

cad_part(
    name = "bracket",
    src = "bracket.py",
    params = {"thickness": "3"},
    deps = ["dims.py"],
)

part_action_test(
    name = "bracket_action_test",
    size = "small",
    params_json = "{\"thickness\": 3}",
    target_under_test = ":bracket",
)

swap_test(
    name = "bracket_swap_test",
    size = "small",
    targets = [":bracket"],
)

determinism_test(
    name = "bracket_determinism_test",
    size = "small",
    target = ":bracket",
)

go_test(
    name = "bracket_files_test",
    size = "small",
    srcs = ["files_test.go"],
    args = ["--files=$(rlocationpaths :bracket)"],
    data = [":bracket"],
    pure = "on",
    deps = ["@rules_go//go/runfiles"],
)

# A value that is not JSON: a string needs its quotes.
cad_part(
    name = "bad_param",
    src = "bracket.py",
    params = {"material": "steel"},
    tags = ["manual"],
    deps = ["dims.py"],
)

fails_test(
    name = "bad_param_test",
    size = "small",
    message = "is not a JSON value",
    target_under_test = ":bad_param",
)

cad_part(
    name = "bad_tolerance",
    src = "bracket.py",
    stl_tolerance = "0",
    tags = ["manual"],
    deps = ["dims.py"],
)

fails_test(
    name = "bad_tolerance_test",
    size = "small",
    message = "STL tolerances must be positive and finite",
    target_under_test = ":bad_tolerance",
)

cad_part(
    name = "infinite_tolerance",
    src = "bracket.py",
    stl_angular_tolerance = "inf",
    tags = ["manual"],
    deps = ["dims.py"],
)

fails_test(
    name = "infinite_tolerance_test",
    size = "small",
    message = "stl_angular_tolerance = \"inf\" is not a number",
    target_under_test = ":infinite_tolerance",
)

cad_part(
    name = "text_tolerance",
    src = "bracket.py",
    stl_tolerance = "abc",
    tags = ["manual"],
    deps = ["dims.py"],
)

fails_test(
    name = "text_tolerance_test",
    size = "small",
    message = "is not a number",
    target_under_test = ":text_tolerance",
)

cad_part(
    name = "dotted_tolerance",
    src = "bracket.py",
    stl_tolerance = "1.2.3",
    tags = ["manual"],
    deps = ["dims.py"],
)

fails_test(
    name = "dotted_tolerance_test",
    size = "small",
    message = "stl_tolerance = \"1.2.3\" is not a number",
    target_under_test = ":dotted_tolerance",
)

# A CadQuery part (issue #15): built by the CadQuery toolchain's runner,
# the same bytes in two configurations, its files read back, and the same
# geometry as its build123d twin.
cad_part(
    name = "cq_block",
    src = "cq_block.py",
    library = "cadquery",
    params = {"height": "6"},
)

cq_runner_test(
    name = "cq_block_runner_test",
    size = "small",
    target_under_test = ":cq_block",
)

swap_test(
    name = "cq_block_swap_test",
    size = "small",
    targets = [":cq_block"],
)

determinism_test(
    name = "cq_block_determinism_test",
    size = "small",
    target = ":cq_block",
)

go_test(
    name = "cq_block_files_test",
    size = "small",
    srcs = ["cq_files_test.go"],
    args = ["--files=$(rlocationpaths :cq_block)"],
    data = [":cq_block"],
    pure = "on",
    deps = ["@rules_go//go/runfiles"],
)

cad_part(
    name = "block",
    src = "block.py",
    params = {"height": "6"},
)

geometry_equal_test(
    name = "cq_block_geometry_test",
    size = "small",
    a = ":block",
    abs_tolerance = "0.001",
    b = ":cq_block",
)
