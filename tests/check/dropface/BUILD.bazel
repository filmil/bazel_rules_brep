load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

# Makes the known-bad open-shell STEP file of //tests/check: a part's STEP
# file with one face taken out of its shell. Test-only.
go_library(
    name = "dropface_lib",
    srcs = ["main.go"],
    importpath = "github.com/filmil/bazel_rules_brep/tests/check/dropface",
    visibility = ["//visibility:private"],
)

go_binary(
    name = "dropface",
    embed = [":dropface_lib"],
    pure = "on",
    visibility = ["//tests/check:__pkg__"],
)

go_test(
    name = "dropface_test",
    size = "small",
    srcs = ["main_test.go"],
    embed = [":dropface_lib"],
    pure = "on",
)
